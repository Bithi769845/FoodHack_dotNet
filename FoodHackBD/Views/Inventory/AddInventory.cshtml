@model Inventory
<h2>Add Inventory</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="FoodItem" class="form-label">Food Item</label>
        <input asp-for="FoodItem" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="AddedDate" class="form-label">Added Date</label>
        <input asp-for="AddedDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
        <input asp-for="ExpiryDate" type="date" class="form-control" />
    </div>
    <!-- Upload dropdown -->
    <div class="mb-3">
        <label>Attach Uploaded File (Optional)</label>
        <select class="form-select" asp-for="UploadId">
            <option value="">-- None --</option>
            @foreach (var file in ViewBag.Uploads as List<Upload>)
            {
                <option value="@file.Id">@file.FileName</option>
            }
        </select>
    </div>

    <button class="btn btn-primary">Add Inventory</button>
</form>
