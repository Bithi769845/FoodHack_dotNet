@model FoodLog
<h2>Add Food Log</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="ItemName" class="form-label">Item Name</label>
        <input asp-for="ItemName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Category</label>
        <input asp-for="Category" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LogDate" class="form-label">Log Date</label>
        <input asp-for="LogDate" type="date" class="form-control" />
    </div>

    <!-- Upload dropdown -->
    <div class="mb-3">
        <label>Attach Uploaded File (Optional)</label>
        <select class="form-select" asp-for="UploadId">
            <option value="">-- None --</option>
            @foreach (var file in ViewBag.Uploads as List<Upload>)
            {
                <option value="@file.Id">@file.FileName</option>
            }
        </select>
    </div>
    <button class="btn btn-primary">Add Log</button>
</form>
