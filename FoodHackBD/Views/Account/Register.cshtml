@model ApplicationUser

<h2>Register</h2>
<form method="post">
    <input asp-for="FullName" class="form-control mb-2" placeholder="Full Name" />
    <input asp-for="Email" class="form-control mb-2" placeholder="Email" />
    <input name="password" type="password" class="form-control mb-2" placeholder="Password" />
    <input asp-for="HouseholdSize" class="form-control mb-2" placeholder="Household Size (Optional)" />
    <input asp-for="DietPreference" class="form-control mb-2" placeholder="Diet Preference (Optional)" />
    <input asp-for="Budget" class="form-control mb-2" placeholder="Budget (Optional)" />
    <input asp-for="Location" class="form-control mb-2" placeholder="Location" />

    <button class="btn btn-primary">Register</button>
</form>


@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger mt-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}